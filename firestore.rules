rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // ⚠️  ملاحظة هندسية مهمة:
    //  التطبيق يستخدم Firestore للمصادقة المخصصة (phone+password)
    //  لذلك request.auth سيكون null دائماً.
    //  الحماية هنا تعتمد على:
    //    1. منع الحذف على كل السجلات الحساسة
    //    2. منع التعديل على سجلات سجل الدخول (audit trail)
    //    3. التحقق من وجود الحقول المطلوبة عند الإنشاء (field validation)
    //    4. رفض تلقائي لأي مجموعة غير مُعرَّفة صراحةً
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    // 1. بيانات المستخدمين
    match /users/{userId} {
      allow read: if true;
      allow create: if
        request.resource.data.fullName is string &&
        request.resource.data.phone is string &&
        request.resource.data.password is string &&
        request.resource.data.role is string;
      allow update: if true;
      allow delete: if false;
    }

    // 2. سجلات الحضور والغياب
    // الخادم يحتاج update لتعديل تسجيل يدوي موجود (manual_by_servant)
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if
        request.resource.data.userId is string &&
        request.resource.data.date is string &&
        request.resource.data.status is string;
      allow update: if true; // مطلوب للتعديل اليدوي من الخادم
      allow delete: if false;
    }

    // 3. إعدادات الخدمة (نافذة الحضور، الـ PIN، الدورة الدراسية، الإجازات، الـ AI)
    match /service_settings/{settingId} {
      allow read: if true;
      allow write: if true; // الخدام يحتاجون كتابة كاملة
      allow delete: if false;
    }

    // 4. صلاحيات الدخول عن بُعد (للخادم يفتح لمخدوم بعينه)
    match /remote_access/{studentId} {
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }

    // 5. الإشعارات والتنبيهات (الخدام يضيفون ويعدلون ويحذفون التنبيهات من لوحة الإشعارات)
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 6. سجل الدخول والأمان (audit trail — مسموح فقط بالإضافة والقراءة، وممنوع التعديل أو الحذف)
    match /login_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // 7. المناهج والمحاضرات والمراجع
    match /service_curriculum/{subjectId} {
      allow read, write: if true;
    }

    // 8. بنك الأسئلة
    match /service_questions/{questionId} {
      allow read, write: if true;
    }

    // 9. النوتة الروحية
    match /spiritual_diaries/{diaryId} {
      allow read, write: if true;
    }

    // 10. الامتحانات الرسمية
    match /service_exams/{examId} {
      allow read, write: if true;
    }

    // 11. إجابات وتسليمات الامتحانات الورقية والإلكترونية
    match /exam_submissions/{submissionId} {
      allow read, write: if true;
    }

    // 12. اقتراحات الميزات (المستخدم يرسل، والخادم يعدل الحالة أو يحذف)
    match /feature_suggestions/{suggestionId} {
      allow read, write: if true;
    }

    // 13. بلاغات الأعطال والمشاكل (المستخدم يبلغ، والخادم يحدث الحالة أو يحذف)
    match /app_errors/{errorId} {
      allow read, write: if true;
    }

    // 14. التقييمات والشهادات الرسمية للطلبة (الخدام يرصدون ويحفظون التقييمات)
    match /official_evaluations/{studentId} {
      allow read, write: if true;
    }

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // 🔒 القاعدة الذهبية: أي مجموعة غير مذكورة صراحةً أعلاه
    //    محظورة القراءة والكتابة بشكل تلقائي كامل.
    //    (لا يوجد wildcard مفتوح هنا بعد الآن)
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  }
}

